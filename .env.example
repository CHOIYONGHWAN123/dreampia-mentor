EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 회원가입 본인인증(PortOne). PortOne 콘솔 > 연동 정보에서 발급받는 값이며,
# storeId/channelKey는 공개 식별자라 클라이언트에 노출해도 안전하다.
# (서버에서 결과를 재조회할 때 쓰는 API Secret은 여기에 두지 않고 admin 저장소의
# Supabase Edge Function 시크릿(PORTONE_API_SECRET)으로만 관리한다.)
EXPO_PUBLIC_PORTONE_STORE_ID=
EXPO_PUBLIC_PORTONE_CHANNEL_KEY=
